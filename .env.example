# ── Groq (free LLM) ──────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── WhatsApp ──────────────────────────────────────
YOUR_PHONE_NUMBER=91XXXXXXXXXX        # your number with country code, no +
WHATSAPP_BOT_URL=http://localhost:3000

# ── Twitter / X ───────────────────────────────────
TWITTER_BEARER_TOKEN=your_bearer_token_here
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# ── Google Calendar ───────────────────────────────
GOOGLE_CREDENTIALS_FILE=credentials.json   # download from Google Cloud Console
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary

# ── News ──────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here          # free at newsapi.org

# ── App ───────────────────────────────────────────
APP_PORT=8000
DIGEST_INTERVAL_HOURS=2
